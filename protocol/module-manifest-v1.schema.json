{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Levi-5k/PaperRemote/main/protocol/module-manifest-v1.schema.json",
  "title": "paperGIF Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "summary", "version", "author", "controls"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "detail", "control"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "category": { "type": "string", "minLength": 1, "maxLength": 40 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 120 },
          "control": { "$ref": "remote-profile-v6.schema.json#/$defs/control" }
        }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "detail", "page"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "detail": { "type": "string", "minLength": 1, "maxLength": 120 },
          "page": { "$ref": "remote-profile-v6.schema.json#/$defs/page" }
        }
      }
    }
  }
}