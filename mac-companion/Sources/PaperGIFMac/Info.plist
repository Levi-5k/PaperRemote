<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>OP Remote</string>
	<key>CFBundleExecutable</key>
	<string>PaperGIFMac</string>
	<key>CFBundleIdentifier</key>
	<string>human-programs.paperGIFMac</string>
	<key>CFBundleName</key>
	<string>OP Remote</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.8</string>
	<key>CFBundleVersion</key>
	<string>9</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>OP Remote reads the current track from Music to show it on your OP Remote display.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>OP Remote uses Bluetooth to discover and configure OP Remote controllers and Matter devices, and to receive controller actions when Wi-Fi is unavailable.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_papergif._tcp</string>
		<string>_papergif-device._tcp</string>
		<string>_matterc._udp</string>
		<string>_matter._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OP Remote finds and configures your M5Paper and companion computers on your local network.</string>
</dict>
</plist>
